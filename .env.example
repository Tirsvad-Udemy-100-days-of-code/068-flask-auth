# Copy to .env at the project root and fill in real values. .env is gitignored
# - never commit it (the project's .gitignore ignores .env and .env.*, and keeps
# .env.example).

# Gitea personal access token (Settings -> Applications -> Generate New Token),
# scoped to issues and milestones only. framework/scripts/sync-project.sh
# --apply uses it against a Gitea remote. The older names SYNC_TOKEN and
# GITEA_TOKEN still work as fallbacks.
# NOT a deploy key - deploy keys authenticate git-over-SSH only, not the API.
TOKEN_FOR_GITEA_ISSUES=

# Gitea personal access token with write access to the repository: push, pull
# requests and merge. Kept apart from TOKEN_FOR_GITEA_ISSUES so the sync needs
# nothing broader.
TOKEN_FOR_GITEA_REPO=

# ---------------------------------------------------------------------------
# Settings of the program itself (src/flask_auth/). The program loads no .env
# file: it reads these from the process environment only, so export them in the
# shell before `python -m flask_auth`. Placeholders only; never commit a value.
# ---------------------------------------------------------------------------

# Secret key that signs the session cookie and the CSRF tokens. Required: the
# app refuses to start without it. Make one with
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Optional. SQLAlchemy database address. Empty means the default
# sqlite:///users.db (the file instance/users.db, which git ignores).
DATABASE_URI=

# Optional. Set to 1 to start the Flask debug server; anything else (or empty)
# keeps debug mode off.
FLASK_AUTH_DEBUG=
